+/// Inspect a raw 802.11 AWDL data frame addressed to us:
+/// returns `Some(true)` for IPv6 TCP, `Some(false)` for IPv6 UDP port 5353 containing `_airdrop`,
+/// and `None` otherwise (such as ICMPv6 keepalive pings or unrelated UDP).
+pub(crate) fn carries_airdrop_unicast(raw: &[u8]) -> Option<bool> {
+    let lim = raw.len().min(96);
+    for i in 24..lim.saturating_sub(10) {
+        if raw[i] == 0x86 && raw[i + 1] == 0xdd && raw[i + 2] >> 4 == 6 {
+            let ip = &raw[i + 2..];
+            if ip.len() < 40 {
+                return None;
+            }
+            let nh = ip[6];
+            if nh == 6 {
+                return Some(true);
+            }
+            if nh == 17 && ip.len() >= 48 {
+                let sport = u16::from_be_bytes([ip[40], ip[41]]);
+                let dport = u16::from_be_bytes([ip[42], ip[43]]);
+                if (sport == 5353 || dport == 5353)
+                    && ip[48..].windows(8).any(|w| w == b"_airdrop")
+                {
+                    return Some(false);
+                }
+            }
+            return None;
+        }
+    }
+    None
 }
